{
  "name": "@mmoonport-labs/unifi-mcp",
  "version": "0.2.0",
  "description": "An MCP server for a UniFi gateway: the whole Network and Protect API through search, describe and call, with dry-run-by-default changes. Unofficial.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmoonport-labs/unifi-mcp.git"
  },
  "homepage": "https://github.com/mmoonport-labs/unifi-mcp#readme",
  "bugs": {
    "url": "https://github.com/mmoonport-labs/unifi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unifi",
    "ubiquiti",
    "unifi-protect",
    "network",
    "router"
  ],
  "mcpName": "io.github.mmoonport-labs/unifi-mcp",
  "type": "module",
  "bin": {
    "unifi-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pretest": "node scripts/fetch-test-specs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "guide",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
